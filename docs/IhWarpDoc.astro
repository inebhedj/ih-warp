---
import T from '@/components/T/T.astro';
import SectionBox from '@/components/SectionBox/SectionBox.astro';
import CodeBlock from '@/components/CodeBlock/CodeBlock.astro';
import CheatsheetTable from '@/components/CheatsheetTable/CheatsheetTable.astro';
import exampleCode from './examples/webpack.config.js?raw';
import meta from './meta.json';
import pkg from '../package.json';

interface Props {
  lang?: string;
}

// Dynamically discover and load all locale files from ./locales/*.json
const localeFiles = import.meta.glob('./locales/*.json', { eager: true });
const locales: Record<string, any> = {};
for (const [path, mod] of Object.entries(localeFiles)) {
  const match = path.match(/\/([^/]+)\.json$/);
  if (match) {
    locales[match[1]] = (mod as any).default ?? mod;
  }
}

const supportedLanguages = Object.keys(locales);

// Base options from default/fallback language (en)
const defaultLocale = locales['en'] || Object.values(locales)[0] || {};
const baseOptions = defaultLocale.options || [];

// Table rows dynamically mapped across all supported languages
const tableRows = baseOptions.map((opt: any, idx: number) => {
  const desc: Record<string, string> = {};
  for (const lang of supportedLanguages) {
    desc[lang] = locales[lang]?.options?.[idx]?.description || opt.description;
  }
  return {
    name: opt.name,
    type: opt.type,
    default: opt.default,
    description: desc
  };
});

const installCommand = meta.installCommand ?? `npm install --save-dev ${pkg.name}`;
const shortName = meta.name || pkg.name;
---

<article>
  <h2 id="toc" class="local-link">
    <T k="doc.toc" />
  </h2>

  <nav class="toc">
    <ul>
      <li>
        <a href="#overview" class="p">
          {shortName} <T k="doc.overview" />
        </a>
        <ul>
          <li>
            <a href="#overview-def" class="p">
              <T k="doc.definitions" />
            </a>
            <ul>
              <li>
                <a href="#requirements" class="p">
                  <T k="doc.requirements" />
                </a>
              </li>
              <li>
                <a href="#installation" class="p">
                  <T k="doc.installation" />
                </a>
              </li>
              <li>
                <a href="#usage" class="p">
                  <T k="doc.usage" />
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </li>
      <li>
        <a href="#options" class="p">
          {shortName} <T k="doc.configuration" />
        </a>
        <ul>
          <li>
            <a href="#options-def" class="p">
              <T k="doc.options" />
            </a>
          </li>
        </ul>
      </li>
    </ul>
  </nav>

  <h2 id="overview" class="local-link">
    {shortName} <T k="doc.overview" />
  </h2>

  <SectionBox id="overview-def" titleK="doc.definitions">
    <p>
      {
        supportedLanguages.map(
          (l) => locales[l]?.overview && <span lang={l}>{locales[l].overview}</span>
        )
      }
    </p>

    <h4 id="requirements" class="local-link">
      <T k="doc.requirements" />
    </h4>
    {
      supportedLanguages.map(
        (lang) =>
          locales[lang]?.requirements && (
            <ul lang={lang}>
              {locales[lang].requirements.map((req: string) => (
                <li>{req}</li>
              ))}
            </ul>
          )
      )
    }

    <h4 id="installation" class="local-link">
      <T k="doc.installation" />
    </h4>
    <h5>
      {
        supportedLanguages.map(
          (l) => locales[l]?.installHeading && <span lang={l}>{locales[l].installHeading}</span>
        )
      }
    </h5>
    <CodeBlock code={installCommand} lang="bash" collapsible={false} />

    <h4 id="usage" class="local-link">
      <T k="doc.usage" />
    </h4>
    <h5>
      {
        supportedLanguages.map(
          (l) => locales[l]?.exampleHeading && <span lang={l}>{locales[l].exampleHeading}</span>
        )
      }
    </h5>
    <CodeBlock code={exampleCode} lang="javascript" />
  </SectionBox>

  <h2 id="options" class="local-link">
    {shortName} <T k="doc.configuration" />
  </h2>

  <SectionBox id="options-def" titleK="doc.options">
    <p>
      {
        supportedLanguages.map(
          (l) =>
            locales[l]?.optionsDescription && (
              <span lang={l}>{locales[l].optionsDescription}</span>
            )
        )
      }
    </p>
    <CheatsheetTable rows={tableRows}>
      <span slot="title">
        {
          supportedLanguages.map(
            (l) =>
              locales[l]?.tableFigcaption && (
                <span lang={l}>{locales[l].tableFigcaption}</span>
              )
          )
        }
      </span>
    </CheatsheetTable>
  </SectionBox>
</article>
